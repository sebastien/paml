#!/usr/bin/env python3
import io
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src", "py"))

import paml.engine

output = sys.stdout
result = paml.engine.run(sys.argv[1:])
if isinstance(output, io.TextIOBase):
    output.write(result)
else:
    output.write(result.encode("utf-8"))
# EOF
